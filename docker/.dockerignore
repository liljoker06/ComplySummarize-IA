# Fichiers et dossiers à ignorer lors de la construction Docker

# Logs
*.log
logs/

# Dépendances
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Fichiers de développement
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Fichiers de cache
.cache/
.parcel-cache/
.next/
.nuxt/
dist/
build/

# Fichiers de test
coverage/
.nyc_output/

# Fichiers de configuration IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Fichiers système
.DS_Store
Thumbs.db

# Git
.git/
.gitignore
.gitattributes

# Docker
Dockerfile*
docker-compose*.yml
.dockerignore

# Documentation
README.md
*.md

# Fichiers temporaires
tmp/
temp/
*.tmp
*.temp

# Uploads (seront créés dans le conteneur)
uploads/

# Base de données locale
*.db
*.sqlite
*.sqlite3 